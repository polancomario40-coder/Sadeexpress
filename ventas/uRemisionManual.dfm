  object rsFacts: TADODataSet
    Connection = dm.Coneccion
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandText = 
      'select '#9'f.idFactura as idCXC,'#13#10'               f.Factura as Factu' +
      'ra,'#13#10#9#39'FT-'#39' + convert(varchar(10), f.Factura) as Documento,'#13#10#9'c.' +
      'Cliente as Nombre,'#13#10#9'f.Fecha,'#9#9#13#10#9'f.Total as Total,'#13#10#9'f.Referenc' +
      'ia, '#13#10#9'f.Cotizacion, '#13#10#9'c.Direccion,'#13#10#9'c.Telefono,'#13#10#9'c.Ciudad,'#13#10 +
      #9#39#39' as Sector,'#13#10#9'f.Total as ValorNeto,'#13#10#9'f.idCliente '#13#10'from Fact' +
      'ura f join Cliente c '#13#10'  on f.idCliente = c.idCliente   '#13#10'where ' +
      'f.idCliente = :idCliente and f.fecha between :desde and :hasta'#13#10 +
      'order by f.Factura'
    Parameters = <
      item
        Name = 'idCliente'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'desde'
        DataType = ftDateTime
        NumericScale = 3
        Precision = 23
        Size = 16
        Value = Null
      end
      item
        Name = 'hasta'
        DataType = ftDateTime
        NumericScale = 3
        Precision = 23
        Size = 16
        Value = Null
      end>
    Left = 488
    Top = 154
