  object rsRemisiones: TADODataSet
    Connection = dm.Coneccion
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandText = 
      'select '#9'f.idFactura as idCXC,'#13#10#9#39'FT-'#39' + Factura as Documento,'#13#10#9 +
      'f.Cliente as Nombre,'#13#10#9'f.Fecha,'#9#9#13#10#9'f.Total as Total,'#13#10#9'f.Refere' +
      'ncia, '#13#10#9'f.Cotizacion, '#13#10#9'c.Direccion,'#13#10#9'c.Telefono as Telefono,' +
      #13#10#9'c.Ciudad,'#13#10#9#39#39' as Sector,'#13#10#9'f.Total as ValorNeto,'#13#10#9'f.idClien' +
      'te '#13#10'from Factura f join Cliente c '#13#10'  on f.idCliente = c.idClie' +
      'nte   '#13#10'where f.Factura = :Numero and f.idCliente = :idCliente'
    Parameters = <
      item
        Name = 'Numero'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 16
        Value = Null
      end
      item
        Name = 'idCliente'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    Left = 167
    Top = 222
