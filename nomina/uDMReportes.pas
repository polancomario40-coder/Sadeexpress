procedure TdmReporte.rsVolanteHAfterScroll(DataSet: TDataSet);
begin
  Tdebito.Parameters[1].Value := rsVolanteHNominaID.Value;
  TDebito.Parameters[2].Value := rsVolanteHEmpleadoID.Value;
  TDebito.Parameters[3].Value := true;
  if TDebito.Active Then TDebito.Requery() else TDebito.Open;

  TCredito.Parameters[1].Value := rsVolanteHNominaID.Value;
  TCredito.Parameters[2].Value := rsVolanteHEmpleadoID.Value;
  TCredito.Parameters[3].Value := false;
  if TCredito.Active Then TCredito.Requery() else TCredito.Open;
end;

procedure TdmReporte.NominaResultDetAfterScroll(DataSet: TDataSet);
begin
  Tdebito.Parameters[1].Value := NominaResultDetNominaID.Value;
  TDebito.Parameters[2].Value := NominaResultDetEmpleadoID.Value;
  TDebito.Parameters[3].Value := true;
  if TDebito.Active Then TDebito.Requery() else TDebito.Open;

  TCredito.Parameters[1].Value := NominaResultDetNominaID.Value;
  TCredito.Parameters[2].Value := NominaResultDetEmpleadoID.Value;
  TCredito.Parameters[3].Value := false;
  if TCredito.Active Then TCredito.Requery() else TCredito.Open;
end;

