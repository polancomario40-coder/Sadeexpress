  object THorasTrabajadas: TADODataSet
    Connection = dm.Coneccion
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandText = 
      'SELECT     TOP 100 PERCENT dbo.Nomina.NominaID, dbo.Nomina.Fecha' +
      ', dbo.Empleado.EmpleadoID, '#13#10'                      dbo.Empleado.' +
      'Nombre + '#39' '#39' + dbo.Empleado.Apellido AS Empleado, dbo.TipoHora.T' +
      'ipoHoraID, dbo.TipoHora.TipoHora, dbo.Hora.Hora'#13#10'FROM         db' +
      'o.Nomina INNER JOIN'#13#10'                      dbo.Hora ON dbo.Nomin' +
      'a.NominaID = dbo.Hora.NominaID INNER JOIN'#13#10'                     ' +
      ' dbo.Empleado ON dbo.Hora.EmpleadoID = dbo.Empleado.EmpleadoID I' +
      'NNER JOIN'#13#10'                      dbo.TipoHora ON dbo.Hora.TipoHo' +
      'raID = dbo.TipoHora.TipoHoraID'#13#10'ORDER BY dbo.Nomina.NominaID, db' +
      'o.TipoHora.TipoHoraID, dbo.Empleado.EmpleadoID'
    DataSource = dmNom.DNomina
    IndexFieldNames = 'NominaID'
    MasterFields = 'NominaID'
    Parameters = <>
    Left = 664
    Top = 192
  end
